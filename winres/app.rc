#include <winres.h>

// FileDescription / ProductName are what Explorer and the Start Menu show.
1 ICON "..\\assets\\app-win.ico"

1 VERSIONINFO
FILEVERSION 2,0,0,0
PRODUCTVERSION 2,0,0,0
FILEOS VOS_NT_WINDOWS32
FILETYPE VFT_APP
BEGIN
  BLOCK "StringFileInfo"
  BEGIN
    BLOCK "040904B0"
    BEGIN
      VALUE "CompanyName", "jonperr"
      VALUE "FileDescription", "Bunkr Downloader"
      VALUE "FileVersion", "2.0.0"
      VALUE "InternalName", "bunkr"
      VALUE "OriginalFilename", "bunkr-gui.exe"
      VALUE "ProductName", "Bunkr Downloader"
      VALUE "ProductVersion", "2.0.0"
      VALUE "LegalCopyright", "GPL-3.0-or-later"
    END
  END
  BLOCK "VarFileInfo"
  BEGIN
    VALUE "Translation", 0x409, 1200
  END
END
